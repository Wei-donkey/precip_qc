# IDE or OS junk (optional but helpful)
.vscode/
.idea/

# Ignore database config with passwords
scripts/config_db.ini

# Local data-preparation scripts (9xx): they need the Oracle database or data that cannot be published
# (the full labeled pool, the monthly radar QPE files). Kept locally, not published; their outputs needed
# by the published scripts (01-19) are included under data/ and outputs/.
scripts/9*.py

